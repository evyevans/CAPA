# Source this file in your terminal after copying it to a private location.
# Use the API key for the Hermes profile CAPA should operate. Never put it in iOS.
CAPA_HERMES_URL=http://127.0.0.1:8642
CAPA_HERMES_KEY=replace-with-your-hermes-api-server-key
# CAPA_DATABASE=/absolute/private/path/capa/bridge.sqlite3

# Optional: Apple token-based push delivery. Without this, retrieve results in app.
# CAPA_APNS_TEAM_ID=your-apple-team-id
# CAPA_APNS_KEY_ID=your-apple-key-id
# CAPA_APNS_KEY_PATH=/absolute/private/path/AuthKey.p8
# CAPA_APNS_BUNDLE_ID=com.yourcompany.capa
CAPA_APNS_SANDBOX=true

# Optional: use existing Hermes STT/TTS configuration. Omit both for device speech.
# These are the Python interpreter/repository of the existing Hermes installation.
# CAPA_HERMES_PYTHON=/absolute/path/hermes-agent/.venv/bin/python
# CAPA_HERMES_REPOSITORY=/absolute/path/hermes-agent
# HERMES_HOME=/absolute/path/to/the/same/hermes/profile
